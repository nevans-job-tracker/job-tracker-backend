#!/bin/sh
# Prints which build is deployed at SSH login (KAN-63).
#
# The fourth of these hooks, and the same reasoning as the other three: a
# silent wrong state is worse than a noisy one. Being on a stale checkout is
# exactly that shape — everything works, it is just not the code anyone
# thinks is running.
#
# Two mismatches are worth catching and neither raises an error on its own:
#
#   - the checkout moved but the service was never restarted, so /health and
#     the app are still answering from the previous build;
#   - the checkout is behind its upstream, i.e. a deploy was never finished.
#
# Nothing here fetches. A login is not the place for network I/O, so "behind"
# means behind as of the last fetch, and says so.
REPO=/opt/job-tracker-backend
STAMP=/var/lib/job-tracker/build-info

[ -d "$REPO/.git" ] || exit 0

git="git -C $REPO -c safe.directory=$REPO"
branch=$($git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
head=$($git rev-parse --short HEAD 2>/dev/null) || exit 0

running=""
[ -r "$STAMP" ] && running=$(sed -n 's/^sha=//p' "$STAMP")

printf '\n  Job Tracker: %s @ %s\n' "$branch" "$head"

if [ -n "$running" ] && [ "$running" != "$head" ]; then
    printf '  \033[1;33m*** serving %s — checkout moved, service not restarted ***\033[0m\n' \
        "$running"
    printf '  sudo systemctl restart job-tracker-backend\n'
fi

behind=$($git rev-list --count "HEAD..@{u}" 2>/dev/null)
if [ -n "$behind" ] && [ "$behind" -gt 0 ]; then
    printf '  \033[1;33m%s commit(s) behind upstream\033[0m (as of the last fetch)\n' \
        "$behind"
fi

printf '\n'
